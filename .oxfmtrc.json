{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "semi": false,
  "printWidth": 100,
  "trailingComma": "none",
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/*.md",
    "src/renderer/src/components/ui",
    ".agents/**",
    ".claude/**",
    "skills/**",
    "tools/oxlint/anti-slop/**"
  ]
}
